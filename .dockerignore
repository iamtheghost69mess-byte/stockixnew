**/node_modules
**/.next
**/dist
!packages/auth/dist
!packages/auth/dist/**
**/.turbo
**/coverage
infra/worker-service/.runtime/
infra/worker-service/.tmp-dist/
.git
.github
*.md
.env
.env.*
!.env.example
# Exclude all services — tenant image builds (prebuild-tenant-images.mjs) run with
# services/stockix-finance as their own build context (cwd=FINANCE_ROOT), so the
# root .dockerignore has no effect on those builds.
services/

# Chatwoot (Ruby/Rails) — not in pnpm workspace, never part of any Docker build.
services/chatlive/

# PMS source not needed inside control-plane images.
services/pms/src/
services/pms/frontend/src/
services/pms/tests/
services/pms/e2e/
# POS backend tests only — app code is plain JS at repo root (no src/).
services/posnew/apps/pos-backend/tests/
# POS tenant images (pnpm pos:images:build) need pos-frontend2 + packages/ui sources.
services/posnew/packages/domain-access/src/
services/posnew/packages/platform-api/src/

# E2E tests never needed inside Docker images
e2e/
**/e2e/

# Large data/fixture files
**/*.sql
**/data/*.json

# Local workspace / tooling — never needed inside any Docker image
.pnpm-store/
scratch/
.claude/
.claude-flow/
.mcp.json
*.log
*.sarif
docs/
services/chatlive/config/llm_models.json
