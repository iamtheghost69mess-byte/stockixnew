# Optional root copy for tools that load .env from the monorepo root.
# Prefer packages/db/.env for Drizzle; apps/api/.env for the API.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/stockix_platform

# --- apps/api/.env (Stockix API — copy vars there for runtime) ---
# PORT=4000
# ROOT_DOMAIN=localhost
# PUBLIC_BASE_URL_SCHEME=http
# MAX_TENANT_PORT=4999
# BIGCAPITAL_ROOT=
# TENANT_ENV_ROOT=
# PROVISION_MAX_CONCURRENT=2
# PROVISION_SSE_HEARTBEAT_MS=15000
# (See apps/api/.env.example for full PROVISION_* tuning list.)

# --- apps/dashboard/.env (Next.js — copy vars there; NEXT_PUBLIC_* is exposed to the browser) ---
# NEXT_PUBLIC_STOCKIX_API_URL=http://localhost:4000
# NEXT_PUBLIC_STOCKIX_ROOT_DOMAIN=localhost
# NEXT_PUBLIC_STOCKIX_PUBLIC_SCHEME=http

# --- Creating a tenant (POST /tenants): slug rules ---
# The slug must match /^[a-z0-9]+(-[a-z0-9]+)*$/ — lowercase DNS label only.
# Good: acme-corp, shop2, x
# Bad: Acme-Corp, acme_corp, acme corp, acme.corp
