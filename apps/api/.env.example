# Stockix API — local testing. After DB is up: pnpm setup:local  then  pnpm dev

# Same URL as packages/db/.env (Stockix platform DB, not BigCapital MySQL).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/stockix_platform

PORT=4000

# Used in generated tenant .env BASE_URL as {scheme}://{slug}.{ROOT_DOMAIN}
ROOT_DOMAIN=localhost

# http = http://{slug}.localhost in tenant env; use https behind real TLS in prod.
PUBLIC_BASE_URL_SCHEME=http

# Upper bound for host ports assigned to tenant nginx (PUBLIC_PROXY_PORT).
MAX_TENANT_PORT=4999

# Vendored BigCapital repo root (default: <monorepo>/services/bigcapital).
# BIGCAPITAL_ROOT=

# Where per-tenant Docker .env files are written (default: %USERPROFILE%\.stockix\tenants on Windows).
# TENANT_ENV_ROOT=

# --- Tenant provisioning (production tuning; defaults are safe) ---
# Max simultaneous POST /tenants background provisions (Docker-heavy).
# PROVISION_MAX_CONCURRENT=2

# BigCapital /api/ping wait: wall-clock timeout for readiness (ms).
# PROVISION_HEALTH_TIMEOUT_MS=180000

# Single HTTP ping attempt timeout (ms).
# PROVISION_HEALTH_FETCH_TIMEOUT_MS=8000

# Fast polling: interval while attempts <= PROVISION_HEALTH_FAST_POLL_ATTEMPTS (ms).
# PROVISION_HEALTH_POLL_MIN_MS=450

# Slow polling: interval after fast window (ms).
# PROVISION_HEALTH_POLL_MAX_MS=2500

# Number of /api/ping attempts at fast interval before backing off to POL_MAX.
# PROVISION_HEALTH_FAST_POLL_ATTEMPTS=90

# database_migration retries and delay between retries.
# PROVISION_MIGRATION_MAX_ATTEMPTS=8
# PROVISION_MIGRATION_RETRY_DELAY_MS=3000

# Any `docker compose` invocation from the API (ms). Prevents hung CLI from blocking workers.
# PROVISION_DOCKER_COMPOSE_TIMEOUT_MS=900000

# POST /api/auth/register from provisioner to tenant BigCapital (ms).
# PROVISION_REGISTER_FETCH_TIMEOUT_MS=120000

# SSE provision-stream keep-alive interval (ms). Helps avoid idle TCP resets during long provisions.
# PROVISION_SSE_HEARTBEAT_MS=15000
