# Stockix API — local testing. After DB is up: pnpm setup:local  then  pnpm dev

# Same URL as packages/db/.env (Stockix platform DB, not Stockix MySQL).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/stockix_platform

PORT=4000
PLATFORM_API_SECRET=change-me
DASHBOARD_URL=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# Used in generated tenant .env BASE_URL as {scheme}://{slug}.{ROOT_DOMAIN}
ROOT_DOMAIN=localhost

# http = http://{slug}.localhost in tenant env; use https behind real TLS in prod.
PUBLIC_BASE_URL_SCHEME=http

# Upper bound for host ports assigned to tenant nginx (PUBLIC_PROXY_PORT).
MAX_TENANT_PORT=4999

# Vendored Stockix Finance repo root (default: <monorepo>/services/stockix-finance).
# STOCKIX_TENANT_APP_ROOT=
# Optional monorepo root override if API is launched from elsewhere.
# REPO_ROOT=

# Where per-tenant Docker .env files are written (default: %USERPROFILE%\.stockix\tenants on Windows).
# TENANT_ENV_ROOT=

# Optional: override Traefik upstream host used in generated tenant routes.
# TRAEFIK_TENANT_UPSTREAM_HOST=host.docker.internal

# Optional: extra CORS origins, comma-separated.
# CORS_ORIGINS=
