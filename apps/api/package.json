{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./worker-public": "./src/worker-public.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node ../../scripts/dev-api.mjs",
    "build": "tsup",
    "start": "node dist/index.js",
    "provision-smoke": "node scripts/provision-smoke.mjs",
    "provision-scenarios": "node scripts/provision-scenarios.mjs",
    "provision-diagnose": "node scripts/provision-diagnose.mjs",
    "provision-modules": "node scripts/provision-module-matrix.mjs",
    "provision-modules-suite": "node scripts/provision-module-suite.mjs",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "check:tenant-scope": "node scripts/audit-tenant-scope.mjs",
    "check:routes": "node scripts/audit-no-inline-routes.mjs",
    "check:known-paths": "node scripts/audit-known-paths.mjs",
    "check:api-structure": "pnpm run check-types && pnpm run check:tenant-scope && pnpm run check:routes && pnpm run check:known-paths"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@repo/auth": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/events": "workspace:*",
    "@repo/shared": "workspace:*",
    "@sentry/node": "^8.40.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.40.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "execa": "^9.5.2",
    "hono": "^4.12.25",
    "ioredis": "^5.4.2",
    "jose": "6.2.3",
    "knex": "^3.1.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^6.9.13",
    "otplib": "^13.4.0",
    "postgres": "^3.4.7",
    "prom-client": "15.1.3",
    "rate-limiter-flexible": "^7.0.0",
    "zod": "^3.24.1",
    "@opentelemetry/sdk-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.50.0",
    "@opentelemetry/auto-instrumentations-node": "^0.43.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.39.1",
    "tsup": "^8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "^4.1.5"
  }
}