{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/ui/*": [
        "../../packages/ui-core/src/*"
      ],
      "@restaurant-pos/ui": ["../../packages/ui-core/src/index.ts"],
      "@restaurant-pos/ui/shell": ["../../packages/ui-shared/src/shell/index.ts"],
      "@repo/ui-core": ["../../packages/ui-core/src/index.ts"],
      "@repo/ui-shared": ["../../packages/ui-shared/src/index.ts"],
      "@repo/theme": ["../../packages/theme/src/index.css"]
    }
  },
  "include": [
    "next-env.d.ts",
    "../../types/recharts-es6-subpaths.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
