# Canonical env template (single source of truth for variable definitions).
# App-specific *.env.example files are projections for bootstrap convenience.
#
# API runtime precedence (highest -> lowest):
#   apps/api/.env.local > apps/api/.env > root/.env
#
# Dashboard behavior:
#   - NEXT_PUBLIC_* values are build-time values.
#   - server-only values are runtime values.

# --- Shared / Database ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/stockix_platform
DB_WAIT_TIMEOUT_MS=90000

# --- API ---
PORT=4000
PLATFORM_API_SECRET=change-me
DASHBOARD_URL=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
ROOT_DOMAIN=localhost
PUBLIC_BASE_URL_SCHEME=http
MAX_TENANT_PORT=4999
STOCKIX_TENANT_APP_ROOT=
REPO_ROOT=
TENANT_ENV_ROOT=
TRAEFIK_DYNAMIC_DIR=
TRAEFIK_TENANT_UPSTREAM_HOST=host.docker.internal
TENANT_INTERNAL_HOST=127.0.0.1
CORS_ORIGINS=

# --- Dashboard ---
SESSION_SECRET=replace-with-32-plus-char-secret
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me
NEXT_PUBLIC_STOCKIX_API_URL=http://localhost:4000
NEXT_PUBLIC_STOCKIX_PUBLIC_SCHEME=http
NEXT_PUBLIC_STOCKIX_ROOT_DOMAIN=localhost
NEXT_PUBLIC_STOCKIX_LOCAL_TENANT_HOST=127.0.0.1

# --- API script-only helpers ---
STOCKIX_API_URL=http://localhost:4000
PROVISION_POLL_MS=2000
PROVISION_MAX_MS=2700000
OWNER_ID=
PROVISION_ADMIN_EMAIL=admin@localhost

# --- Infra / prod compose ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=stockix_platform
POSTGRES_HOST_PORT=54330
ACME_EMAIL=you@stockix.cloud
CF_DNS_API_TOKEN=
STOCKIX_REPO=/opt/stockix/app
