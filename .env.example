# CANONICAL ENV SCHEMA — single source of truth for all services
#
# Human-readable guide (what each area means, local vs production):
#   docs/envexplanation.md
#
# Where env files typically live:
#   ./.env / .env.local          — primary local dev (API + Dashboard both load via @repo/config; see dashboard next.config.ts)
#   ./apps/api/.env              — optional; NOT loaded by the API runtime — use repo root instead
#   ./apps/dashboard/.env        — optional legacy; prefer repo root so secrets stay in sync with the API
#   ./infra/prod/.env            — production compose (--env-file); see infra/prod/.env.example
#
# Copy to `.env` after clone (`pnpm bootstrap:env`) or merge into `.env.local`.
# Loading order: `.env` first, then `.env.local` overrides (see packages/config). Never commit real secrets.

# NODE
# Node environment profile used by runtime and build paths.
NODE_ENV=development
# Hostname label used in runtime logging and process identity.
HOSTNAME=server

# DATABASE
# Control-plane Postgres connection string for platform data.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/stockix_platform
# Maximum wait window (ms) for local Postgres readiness checks.
DB_WAIT_TIMEOUT_MS=90000
# Optional database client override used by legacy Stockix services.
DB_CLIENT=
# Database host used by legacy Stockix service runtime.
DB_HOST=
# Database username used by legacy Stockix service runtime.
DB_USER=
# Database password used by legacy Stockix service runtime.
DB_PASSWORD=
# Database charset used by legacy Stockix service runtime.
DB_CHARSET=
# System database client used by legacy Stockix service runtime.
SYSTEM_DB_CLIENT=
# System database host used by legacy Stockix service runtime.
SYSTEM_DB_HOST=
# System database user used by legacy Stockix service runtime.
SYSTEM_DB_USER=
# System database password used by legacy Stockix service runtime.
SYSTEM_DB_PASSWORD=
# System database name used by legacy Stockix service runtime.
SYSTEM_DB_NAME=stockix_system
# System database charset used by legacy Stockix service runtime.
SYSTEM_DB_CHARSET=
# Tenant database client used by legacy Stockix service runtime.
TENANT_DB_CLIENT=
# Tenant database name prefix for per-tenant database naming.
TENANT_DB_NAME_PREFIX=stockix_tenant_
# Legacy typo alias retained for compatibility with older tenant stacks.
TENANT_DB_NAME_PERFIX=stockix_tenant_
# Tenant database host used by legacy Stockix service runtime.
TENANT_DB_HOST=
# Tenant database user used by legacy Stockix service runtime.
TENANT_DB_USER=
# Tenant database password used by legacy Stockix service runtime.
TENANT_DB_PASSWORD=
# Tenant database charset used by legacy Stockix service runtime.
TENANT_DB_CHARSET=

# API
# HTTP port for the API service listener.
PORT=4000
# Shared API key expected on privileged platform routes.
PLATFORM_API_SECRET=__MUST_OVERRIDE__
# Secret for worker service and POST /internal/jobs/:id/complete (must match worker container).
WORKER_SECRET=dev-worker-secret
# Infra worker: claims tenant.provision jobs via POST /internal/jobs/claim (same DATABASE_URL + WORKER_SECRET as API).
# `pnpm dev` / `npm run dev` at repo root also starts this worker (after `pnpm infra:worker:build`). For worker only: pnpm infra:worker:dev
# Public dashboard URL used in API auth and redirect flows.
DASHBOARD_URL=http://localhost:3000
# Canonical root domain for tenant hostnames.
ROOT_DOMAIN=localhost
# Public URL scheme used when constructing externally visible links.
PUBLIC_BASE_URL_SCHEME=http
# Maximum tenant proxy port allocation in local/dev mode.
MAX_TENANT_PORT=4999
# Absolute path to vendored Stockix tenant app root (finance monorepo).
# Optional: when empty, provisioning resolves `${REPO_ROOT}/services/stockix-finance`.
STOCKIX_TENANT_APP_ROOT=
# Absolute monorepo root used by provisioning scripts.
REPO_ROOT=
# Root directory where per-tenant env files are generated.
TENANT_ENV_ROOT=
# Directory where Traefik dynamic configuration files are written.
TRAEFIK_DYNAMIC_DIR=/opt/stockix/traefik-dynamic
# Upstream host used by Traefik to route tenant traffic.
TRAEFIK_TENANT_UPSTREAM_HOST=host.docker.internal
# Internal host used for tenant service reachability checks.
TENANT_INTERNAL_HOST=127.0.0.1
# Comma-separated allowlist of CORS origins.
CORS_ORIGINS=
# API base URL used by local smoke and helper scripts.
STOCKIX_API_URL=http://localhost:4000
# Poll interval (ms) for provisioning status checks.
PROVISION_POLL_MS=2000
# Maximum wait (ms) for provisioning completion checks.
PROVISION_MAX_MS=2700000
# Target owner id used by provisioning and smoke scripts.
OWNER_ID=
# Provisioned tenant admin email used by helper scripts.
PROVISION_ADMIN_EMAIL=admin@localhost
# Worker claim/request id used in internal execution contexts.
WORKER_JOB_ID=
# Max time (ms) for one worker job (provision/deprovision/lifecycle) before aborting. Default 2700000 (45m), aligned with PROVISION_MAX_MS; raise if first-time Docker builds exceed this.
WORKER_JOB_EXECUTION_TIMEOUT_MS=2700000
# Metrics sink endpoint URL for API and worker telemetry export.
METRICS_ENDPOINT=
# Bearer token for authenticating to the metrics sink endpoint.
METRICS_AUTH_TOKEN=

# AUTH
# Session signing secret for dashboard and API session cookies.
SESSION_SECRET=__MUST_OVERRIDE__
# Auth token signing secret for API-issued auth/JWT tokens.
AUTH_TOKEN_SECRET=__MUST_OVERRIDE__
# HS256 secret for POS offline license JWTs (min 32 characters in staging/production).
LICENSE_SIGNING_SECRET=__MUST_OVERRIDE__
# Enables bootstrap login fallback for local break-glass workflows.
ALLOW_BOOTSTRAP_LOGIN=false
# Bootstrap admin email used for local first-run authentication.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Bootstrap admin password used for local first-run authentication.
BOOTSTRAP_ADMIN_PASSWORD=__MUST_OVERRIDE__
# Platform admin login email for dashboard auth route helpers.
PLATFORM_ADMIN_EMAIL=admin@example.com
# Platform admin login password for dashboard auth route helpers.
PLATFORM_ADMIN_PASSWORD=__MUST_OVERRIDE__
# Deployment secret used to derive deterministic tenant secret material.
DEPLOYMENT_SECRET_KEY=__MUST_OVERRIDE__
# JWT secret used by legacy Stockix server runtime.
JWT_SECRET=
# Signup policy toggle for legacy Stockix runtime.
SIGNUP_DISABLED=true
# Comma-separated domain allowlist for legacy Stockix signup.
SIGNUP_ALLOWED_DOMAINS=
# Comma-separated email allowlist for legacy Stockix signup.
SIGNUP_ALLOWED_EMAILS=

# DASHBOARD PUBLIC
# Browser-visible API URL consumed by dashboard clients.
NEXT_PUBLIC_STOCKIX_API_URL=http://localhost:4000
# Browser-visible scheme used for tenant URL derivation.
NEXT_PUBLIC_STOCKIX_PUBLIC_SCHEME=http
# Browser-visible root domain used for tenant URL derivation.
NEXT_PUBLIC_STOCKIX_ROOT_DOMAIN=localhost
# Browser-visible local host override for tenant development.
NEXT_PUBLIC_STOCKIX_LOCAL_TENANT_HOST=127.0.0.1

# SECURITY HEADERS
# Strict-Transport-Security header value applied by dashboard proxy.
SECURITY_HSTS=max-age=31536000; includeSubDomains
# X-Frame-Options header value applied by dashboard proxy.
SECURITY_X_FRAME_OPTIONS=DENY
# Referrer-Policy header value applied by dashboard proxy.
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# X-Content-Type-Options header value applied by dashboard proxy.
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
# Base Content-Security-Policy string used by dashboard proxy.
SECURITY_CSP_BASE=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# INFRA / DEPLOY
# Postgres username for production compose stack.
POSTGRES_USER=postgres
# Postgres password for production compose stack.
POSTGRES_PASSWORD=__MUST_OVERRIDE__
# Postgres database name for production compose stack.
POSTGRES_DB=stockix_platform
# Host-exposed Postgres port for production compose stack.
POSTGRES_HOST_PORT=54330
# ACME contact email used by Traefik certificate resolver.
ACME_EMAIL=ops@example.com
# Cloudflare DNS API token for Traefik DNS challenge.
CF_DNS_API_TOKEN=__MUST_OVERRIDE__
# Absolute path to repository checkout on deployment host.
STOCKIX_REPO=/opt/stockix/stockixnew

# TENANT STACK
# Public base URL for a tenant service deployment.
BASE_URL=https://{slug}.{ROOT_DOMAIN}
# Public HTTP proxy port published by tenant nginx service.
PUBLIC_PROXY_PORT=
# Public HTTPS proxy port retained for Stockix compatibility.
PUBLIC_PROXY_SSL_PORT=443
# MongoDB URL used by tenant runtime for application data.
MONGODB_DATABASE_URL=mongodb://mongo/stockix

# MAIL
# SMTP host for transactional email from Stockix tenant services.
MAIL_HOST=
# SMTP username for transactional email from Stockix tenant services.
MAIL_USERNAME=
# SMTP password for transactional email from Stockix tenant services.
MAIL_PASSWORD=
# SMTP port for transactional email from Stockix tenant services.
MAIL_PORT=
# SMTP TLS toggle (true/false) for tenant email transport.
MAIL_SECURE=
# Sender display name used in outbound tenant emails.
MAIL_FROM_NAME=
# Sender email address used in outbound tenant emails.
MAIL_FROM_ADDRESS=

# WORKER / JOBS
# Agendash basic-auth username for queue dashboard access.
AGENDASH_AUTH_USER=agendash
# Agendash basic-auth password for queue dashboard access.
AGENDASH_AUTH_PASSWORD=
# Agenda Mongo collection name used by legacy Stockix scheduler.
AGENDA_DB_COLLECTION=
# Agenda polling interval value used by legacy Stockix scheduler.
AGENDA_POOL_TIME=
# Agenda worker concurrency value used by legacy Stockix scheduler.
AGENDA_CONCURRENCY=
# EasySMS token used by legacy Stockix SMS provider integration.
EASY_SMS_TOKEN=

# TEST / TOOLING
# Playwright base URL used by e2e test runner.
PLAYWRIGHT_TEST_BASE_URL=http://localhost:4000
# Owner id used by smoke-idempotency test script.
SMOKE_OWNER_ID=
# Optional browser websocket endpoint for remote browser execution.
BROWSER_WS_ENDPOINT=
# Optional public URL override used by legacy webapp runtime.
PUBLIC_URL=
# Optional package metadata path surfaced by npm runtime.
npm_package_json=
# Optional package type surfaced by npm runtime.
npm_package_type=
# Optional monorepo version string injected at build time.
MONOREPO_VERSION=

# --- Documentation ---
# Variable-by-variable meaning and local vs prod checklist: docs/envexplanation.md
