server {
  listen 80 default_server;

  # Upstream timeouts — avoids nginx 502 when Node/MySQL is slow after login.
  proxy_connect_timeout 75s;
  proxy_send_timeout 75s;
  proxy_read_timeout 75s;
  proxy_http_version 1.1;

  # Docker's embedded DNS — forces nginx to re-resolve upstream IPs after container
  # restarts instead of caching the old IP and returning 502.
  resolver 127.0.0.11 valid=10s ipv6=off;

  location /api {
    set $api_upstream http://server:${SERVER_PROXY_PORT};
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }

  location / {
    set $webapp_upstream http://webapp;
    proxy_pass $webapp_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }

  location /.well-known/acme-challenge/ {
    root /var/www/letsencrypt/;
    log_not_found off;
  }
}