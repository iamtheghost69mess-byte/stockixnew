# Standalone dev only — copy to .env when running packages/server in isolation
# See packages/server/src/common/config/*.ts for variables read by NestJS ConfigModule

# Application
PORT=3000
BASE_URL=http://localhost:3000
# Comma-separated WebSocket origins. Required in production (refuses to start if unset).
SOCKET_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
APP_JWT_SECRET=

# Internal API secret (platform provisioning hooks)
INTERNAL_API_SECRET=

# Mail (Resend SMTP)
MAIL_HOST=smtp.resend.com
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM_NAME=Stockix
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_USER=stockix
DB_PASSWORD=stockix
DB_CHARSET=utf8

# System database
SYSTEM_DB_NAME=stockix_system

# Tenant databases
TENANT_DB_NAME_PERFIX=stockix_tenant_

# Application URLs / proxy
PUBLIC_PROXY_PORT=80
PUBLIC_PROXY_SSL_PORT=443

# Sign-up restrictions
SIGNUP_DISABLED=true
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
SIGNUP_EMAIL_CONFIRMATION=false

# Gotenberg (PDF)
GOTENBERG_HOST_PORT=9001
GOTENBERG_URL=http://localhost:9001
GOTENBERG_DOCS_URL=http://localhost:3000/public/

# Exchange rates (leave empty for manual entry)
EXCHANGE_RATE_SERVICE=
OPEN_EXCHANGE_RATE_APP_ID=

# Plaid
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_LINK_WEBHOOK=

# LemonSqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# S3 storage
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_FORCE_PATH_STYLE=

# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=

# Stripe Payment
STRIPE_PAYMENT_SECRET_KEY=
STRIPE_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PAYMENT_CLIENT_ID=
STRIPE_PAYMENT_WEBHOOKS_SECRET=
STRIPE_PAYMENT_REDIRECT_URL=

# Redis / queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_HOST=localhost
QUEUE_PORT=6379

# Throttling (optional)
# THROTTLE_GLOBAL_TTL=60000
# THROTTLE_GLOBAL_LIMIT=100
# THROTTLE_AUTH_TTL=60000
# THROTTLE_AUTH_LIMIT=10

# Bull Board (optional)
BULL_BOARD_ENABLED=false
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=

# Banking feeds
BANK_FEED_ENABLED=false

# Hosted cloud edition
HOSTED_ON_BIGCAPITAL_CLOUD=false

# Loops email (optional)
# LOOPS_API_KEY=

# Inventory jobs
# INVENTORY_SCHEDULE_COMPUTE_ITEM_COST=
