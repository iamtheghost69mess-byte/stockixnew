REACT_APP_VERSION=$npm_package_version
TSC_COMPILE_ON_ERROR=true
ESLINT_NO_DEV_ERRORS=true

# Stockix platform integration
REACT_APP_STOCKIX_API_URL=
# Public discovery slug from control plane tenant_config.public_discovery_slug (not tenant UUID)
REACT_APP_STOCKIX_DISCOVERY_SLUG=
# Deprecated: use REACT_APP_STOCKIX_DISCOVERY_SLUG for public branding fetch
REACT_APP_STOCKIX_TENANT_ID=

# Optional: override bundled Stockix logo (e.g. URL from owner dashboard tenant config)
VITE_STOCKIX_LOGO_URL=