# Single-tenant Stockix (run from `services/stockix-finance` with docker-compose / local dev).
# For Stockix-managed **per-tenant** stacks, see `infra/tenant-stack/.env.template` (generated per slug).

# Mail
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=
MAIL_SECURE=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# Database
# - Local dev (server runs on host, docker-compose up from services/stockix-finance): 127.0.0.1
# - Inside Docker Compose network (tenant-stack / prod): use the service name, e.g. mysql
DB_HOST=127.0.0.1
DB_USER=stockix
DB_PASSWORD=stockix
DB_ROOT_PASSWORD=root
DB_CHARSET=utf8

# System database
SYSTEM_DB_NAME=stockix_system

# Tenant DB name prefix (upstream env key spelling: TENANT_DB_NAME_PERFIX)
TENANT_DB_NAME_PERFIX=stockix_tenant_

# Application — set BASE_URL to where users open the app (local dev often http://localhost:PORT)
BASE_URL=http://localhost:80
# Generate a long random secret for production, e.g. openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-secret

# MongoDB
# - Local dev (server runs on host, docker-compose up from services/stockix-finance): mongodb://127.0.0.1:27017/stockix
# - Inside Docker Compose network (tenant-stack / prod): mongodb://mongo/stockix
MONGODB_DATABASE_URL=mongodb://127.0.0.1:27017/stockix

# Published proxy ports (host)
PUBLIC_PROXY_PORT=80
PUBLIC_PROXY_SSL_PORT=443

# Agendash
AGENDASH_AUTH_USER=agendash
AGENDASH_AUTH_PASSWORD=change-me

# Sign-up (Stockix provisioner uses SIGNUP_DISABLED=true + SIGNUP_ALLOWED_EMAILS)
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
