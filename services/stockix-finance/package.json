{
  "name": "stockix-monorepo",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install",
    "dev": "lerna run dev",
    "build": "lerna run build",
    "dev:webapp": "lerna run dev --scope \"@stockix/webapp\"",
    "build:webapp": "lerna run build --scope \"@stockix/webapp\"",
    "dev:server": "lerna run dev --scope \"@stockix/server\"",
    "build:server": "lerna run build --scope \"@stockix/server\"",
    "typecheck": "pnpm --filter @stockix/server typecheck && pnpm --filter @stockix/webapp typecheck",
    "serve:server": "lerna run serve --scope \"@stockix/server\"",
    "test:e2e": "playwright test",
    "prepare": "node -e \"const{existsSync}=require('fs');const{execSync}=require('child_process');if(existsSync('.git'))execSync('husky install',{stdio:'inherit'})\""
  },
  "workspaces": [
    "packages/*",
    "shared/*"
  ],
  "devDependencies": {
    "postcss": "8.4.31",
    "@commitlint/config-conventional": "17.4.2",
    "@commitlint/config-lerna-scopes": "17.4.2",
    "husky": "8.0.3",
    "lerna": "6.4.1",
    "@commitlint/cli": "17.4.2",
    "@playwright/test": "1.32.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "bson": "1.1.6",
      "mongodb": "3.6.11",
      "@tiptap/core": "2.1.13",
      "@tiptap/pm": "2.1.13",
      "@tiptap/starter-kit": "2.1.13",
      "@tiptap/react": "2.1.13",
      "@tiptap/extension-horizontal-rule": "2.1.13",
      "@tiptap/extension-color": "2.1.13",
      "@tiptap/extension-list-item": "2.1.13",
      "@tiptap/extension-text-style": "2.1.13",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "postcss@<8.5.10": ">=8.5.10",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "tough-cookie@<4.1.3": ">=4.1.3"
    }
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "_moduleAliases": {
    "@": "packages/server/build"
  },
  "_pnpmOverridesMovedToRoot": "pnpm.overrides and peerDependencyRules moved to repo root package.json (stockixnew/package.json) — pnpm only applies overrides at workspace root."
}
