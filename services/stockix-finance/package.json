{
  "name": "stockix-monorepo",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install",
    "dev": "lerna run dev",
    "build": "lerna run build",
    "dev:webapp": "lerna run dev --scope \"@stockix/webapp\"",
    "build:webapp": "lerna run build --scope \"@stockix/webapp\"",
    "dev:server": "lerna run dev --scope \"@stockix/server\"",
    "build:server": "lerna run build --scope \"@stockix/server\"",
    "typecheck": "pnpm --filter @stockix/server typecheck && pnpm --filter @stockix/webapp typecheck",
    "serve:server": "lerna run serve --scope \"@stockix/server\"",
    "test:e2e": "playwright test",
    "prepare": "husky install"
  },
  "workspaces": [
    "packages/*",
    "shared/*"
  ],
  "devDependencies": {
    "postcss": "8.4.31",
    "@commitlint/config-conventional": "17.4.2",
    "@commitlint/config-lerna-scopes": "17.4.2",
    "husky": "8.0.3",
    "lerna": "6.4.1",
    "@commitlint/cli": "17.4.2",
    "@playwright/test": "1.32.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "_moduleAliases": {
    "@": "packages/server/build"
  },
  "_pnpmOverridesMovedToRoot": "pnpm.overrides and peerDependencyRules moved to repo root package.json (stockixnew/package.json) — pnpm only applies overrides at workspace root."
}
