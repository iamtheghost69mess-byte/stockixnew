# Single-tenant BigCapital (run from `services/bigcapital` with docker-compose / local dev).
# For Stockix-managed **per-tenant** stacks, see `infra/tenant-stack/.env.template` (generated per slug).

# Mail
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=
MAIL_SECURE=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# Database (Compose service name in prod / Stockix tenant stack: `mysql`)
DB_HOST=mysql
DB_USER=bigcapital
DB_PASSWORD=bigcapital
DB_ROOT_PASSWORD=root
DB_CHARSET=utf8

# System database
SYSTEM_DB_NAME=bigcapital_system

# Tenant DB name prefix (upstream env key spelling: TENANT_DB_NAME_PERFIX)
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# Application — set BASE_URL to where users open the app (local dev often http://localhost:PORT)
BASE_URL=http://localhost:80
# Generate a long random secret for production, e.g. openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-secret

# MongoDB
# - All services in **one Docker Compose network** (prod / Stockix tenant): mongodb://mongo/bigcapital
# - API running on host, Mongo published to localhost: mongodb://127.0.0.1:27017/bigcapital
MONGODB_DATABASE_URL=mongodb://mongo/bigcapital

# Published proxy ports (host)
PUBLIC_PROXY_PORT=80
PUBLIC_PROXY_SSL_PORT=443

# Agendash
AGENDASH_AUTH_USER=agendash
AGENDASH_AUTH_PASSWORD=change-me

# Sign-up (Stockix provisioner uses SIGNUP_DISABLED=true + SIGNUP_ALLOWED_EMAILS)
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
