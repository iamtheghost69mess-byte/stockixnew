# PMS Frontend — Environment Template
# Next.js app — NEXT_PUBLIC_* vars are baked in at build time.

# URL of the PMS Hono API (same machine in dev, Docker service name in prod)
NEXT_PUBLIC_PMS_API_URL=http://localhost:3003

# Auth cookie name (must match what the control plane sets)
# Read-only — do not change unless apps/api cookie name changes
NEXT_PUBLIC_SESSION_COOKIE=stockix-session
