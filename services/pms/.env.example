# PMS Service — Environment Template
#
# This service uses @repo/config which loads the repo root .env automatically
# when running inside the Turborepo workspace (pnpm dev).
#
# For standalone operation (outside Turborepo), copy relevant vars here.
# NEVER copy this file with real secrets — use .env (gitignored).

NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# PMS uses the control-plane Postgres (same DATABASE_URL as apps/api).
# Set PMS_DATABASE_URL only if running a dedicated PMS database.
# Default: inherits DATABASE_URL from root .env via @repo/config
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/stockix_platform

# ── Auth ───────────────────────────────────────────────────────────────────
# CRITICAL: must be IDENTICAL to AUTH_TOKEN_SECRET in root .env.
# PMS validates Stockix product JWTs using this secret.
AUTH_TOKEN_SECRET=

# ── Service ────────────────────────────────────────────────────────────────
PMS_PORT=3003

# ── CORS (required — no wildcard fallback) ─────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://dashboard.stockix.cloud

# ── Internal API ───────────────────────────────────────────────────────────
# Must match INTERNAL_API_SECRET in root .env
INTERNAL_API_SECRET=
PLATFORM_API_SECRET=

# ── iCal Sync ──────────────────────────────────────────────────────────────
# How often to pull iCal feeds from Airbnb, Booking.com, etc. (ms)
PMS_ICAL_SYNC_INTERVAL_MS=600000

# ── Passport OCR (optional) ────────────────────────────────────────────────
# Google Gemini API key for guest passport OCR feature
GEMINI_API_KEY=

# ── Mail ───────────────────────────────────────────────────────────────────
# Uses same Resend SMTP as root — inherited via @repo/config
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM_NAME=Stockix
MAIL_FROM_ADDRESS=noreply@yourdomain.com
