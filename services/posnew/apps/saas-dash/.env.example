# Backend origin (no trailing slash). CORS must allow the dashboard origin (pos-backend includes :3010 by default).
# In development, if unset, the app defaults to http://localhost:8010 (see platform-constants.ts).
NEXT_PUBLIC_POS_API_ORIGIN=http://localhost:8010
# Tenant app origin used when opening organization URLs from platform dashboard.
# Example: http://localhost:3000 or your deployed tenant domain.
NEXT_PUBLIC_TENANT_APP_ORIGIN=http://localhost:3000

# When you are ready to enforce CSP (Phase 8), set true after verifying report-only logs.
# PLATFORM_CSP_ENFORCE=false

# Optional — session warning (see docs/HANDOFF.md). API does not return token expiry on /auth/me.
# NEXT_PUBLIC_PLATFORM_SESSION_WARN_LEAD_MS=300000
# NEXT_PUBLIC_PLATFORM_IDLE_MS_BEFORE_WARN=1500000
