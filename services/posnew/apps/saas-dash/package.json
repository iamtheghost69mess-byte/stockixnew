{
	"name": "saas-dash",
	"version": "0.1.0",
	"private": true,
	"nx": {
		"tags": [
			"type:app",
			"scope:platform-dash"
		],
		"targets": {
			"build": {
				"executor": "nx:run-script",
				"options": {
					"script": "build"
				}
			},
			"test": {
				"executor": "nx:run-script",
				"options": {
					"script": "test:unit"
				}
			}
		}
	},
	"scripts": {
		"dev": "next dev --port 3010",
		"build": "next build",
		"analyze": "ANALYZE=true next build",
		"start": "next start --port 3010",
		"lint": "npx biome check --reporter=summary src",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:auth-repair": "playwright test e2e/auth-repair.phase.spec.ts",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@restaurant-pos/domain-access": "*",
		"@restaurant-pos/platform-api": "*",
		"@restaurant-pos/ui": "*",
		"@sentry/react": "^8.55.0",
		"@tanstack/react-query": "^5.66.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"lucide-react": "^1.7.0",
		"next": "^16.2.3",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-hook-form": "^7.72.1",
		"recharts": "^3.8.0",
		"shadcn": "^4.2.0",
		"sonner": "^2.0.7",
		"swagger-ui-react": "5.18.3",
		"tailwind-merge": "^3.5.0",
		"zod": "^3.23.8",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@next/bundle-analyzer": "^16.2.3",
		"@playwright/test": "^1.49.1",
		"@tailwindcss/postcss": "^4.2.2",
		"@types/node": "^22.19.17",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/swagger-ui-react": "^5.18.0",
		"jsdom": "^26.0.0",
		"msw": "^2.7.0",
		"postcss": "^8.5.9",
		"tailwindcss": "^4.1.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vitest": "^3.0.5"
	}
}
