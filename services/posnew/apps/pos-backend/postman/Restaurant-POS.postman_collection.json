              "mode": "raw",
              "raw": "{\n  \"customerDetails\": { \"name\": \"Walk-in\", \"phone\": \"5550001111\", \"guests\": 2 },\n  \"orderStatus\": \"pending\",\n  \"bills\": { \"total\": 100, \"tax\": 10, \"totalWithTax\": 110 },\n  \"items\": [],\n  \"table\": \"{{tableId}}\"\n}"
