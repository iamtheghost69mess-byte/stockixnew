{
  "info": {
    "_postman_id": "a1b2c3d4-pos-backend-001",
    "name": "Restaurant POS API",
    "description": "Phase 1 auth: PIN and/or email+password. `POST /api/auth/login` (or legacy `/api/user/login`) returns `accessToken` + `refreshToken`. Use Login to set collection vars.\nProtected routes: `Bearer {{accessToken}}` or cookies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "tableId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "orderLineId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login PIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.accessToken) { pm.collectionVariables.set('accessToken', j.accessToken); }",
                  "if (j.refreshToken) { pm.collectionVariables.set('refreshToken', j.refreshToken); }",
                  "if (j.data && j.data._id) { pm.collectionVariables.set('userId', j.data._id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "`pin` (4–6 digits) or `{ \"email\", \"password\" }`. Sets access + refresh tokens."
          }
        },
        {
          "name": "Login email (optional)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.accessToken) { pm.collectionVariables.set('accessToken', j.accessToken); }",
                  "if (j.refreshToken) { pm.collectionVariables.set('refreshToken', j.refreshToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"change_me_8chars\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.accessToken) { pm.collectionVariables.set('accessToken', j.accessToken); }",
                  "if (j.refreshToken) { pm.collectionVariables.set('refreshToken', j.refreshToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "Send refresh JWT from login response body (or rely on cookie in browser)."
          }
        },
        {
          "name": "Register (admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password12\",\n  \"role\": \"waiter\",\n  \"pin\": \"5678\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "phases.md Phase 1: admin-only create with email + password; optional PIN for floor login."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/user"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Clears refresh server-side and cookies (browser)."
          }
        }
      ]
    },
    {
      "name": "Config",
      "item": [
        {
          "name": "Get tax rate",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/config/tax",
            "description": "Returns `{ rate, ratePercent }` for POS totals."
          }
        },
        {
          "name": "Put tax rate (admin or manager)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ratePercent\": 5.25\n}"
            },
            "url": "{{baseUrl}}/api/config/tax",
            "description": "Alternatively send `{ \"rate\": 0.0525 }` (decimal 0–1)."
          }
        }
      ]
    },
    {
      "name": "Users (admin or manager)",
      "item": [
        {
          "name": "List users",
