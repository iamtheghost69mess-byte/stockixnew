            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ready\"\n}"
            },
            "url": "{{baseUrl}}/api/order/{{orderId}}/items/{{orderLineId}}/status",
            "description": "Body: `status` or `itemStatus` — one of pending, sent, ready, served. Set `orderLineId` from `GET /api/order/:id` → `items[i]._id`."
