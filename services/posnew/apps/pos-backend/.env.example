# Backend env template — copy to .env and fill values.

# Use a free port on your machine. 8000 often conflicts with Docker (e.g. InvenTree).
PORT=8010
NODE_ENV=development

# Phase 8 — base URL embedded in table QR codes for guest self-order (default in code: http://localhost:5173)
PUBLIC_APP_URL=http://localhost:5173
# Comma-separated *extra* CORS origins (merged with built-in defaults — you usually do not need this).
# CORS_ORIGINS=http://localhost:9999
# Local dev: send auth cookies on credentialed fetches from another localhost port (e.g. Next :3000 → API :8010). Re-login after toggling. Never enable in production.
# POS_DEV_CROSS_SITE_COOKIES=true
# Default in code if unset: mongodb://localhost:27017/pos-db
MONGODB_URI=mongodb://localhost:27017/pos-db
# Optional — comma-separated DNS servers for Node SRV lookup (mongodb+srv). In non-production,
# if unset and URI is mongodb+srv, defaults to 1.1.1.1 + 8.8.8.8 (fixes some Windows resolvers).
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Required for JWT — use a long random string (e.g. openssl rand -base64 32)
JWT_SECRET=
# Optional: HMAC key stored with staff PIN rows (`pinLookup`). Defaults to JWT_SECRET.
# If JWT_SECRET ever changes, re-run `npm run seed:dev` (or staff PIN save) unless you keep PIN_LOOKUP_SECRET fixed.
# PIN_LOOKUP_SECRET=

# Local testing — one user per role (PINs 1001–1005). Run:  npm run seed:dev
# (Skipped in production unless ALLOW_DEV_SEED=1.)

# First admin (no public signup): after JWT_SECRET is set, run `npm run seed:admin`
# BOOTSTRAP_ADMIN_PIN must be 4–6 digits.
BOOTSTRAP_ADMIN_PIN=
BOOTSTRAP_ADMIN_NAME=Admin
# Optional — Phase 1 email login (phases.md); password must be 8+ characters
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Optional
# BOOTSTRAP_ADMIN_PHONE=

# Optional — defaults to "<JWT_SECRET>:refresh" if unset
# JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=1d
# JWT_REFRESH_EXPIRES_IN=7d

# Phase 2: sample menu (Salads, Hot Kitchen, Bar, Desserts + 10 items)
# npm run seed:menu
# Uploaded images are stored under pos-backend/uploads/ (gitignored except .gitkeep)

# Razorpay (optional until payment features are used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SaaS platform plane (multi-tenant) ---
# Required in production. In development, defaults to "<JWT_SECRET>:platform" if unset.
PLATFORM_JWT_SECRET=
# Optional overlap window for JWT rotation (verify-only)
# PLATFORM_JWT_SECRET_PREVIOUS=
# PLATFORM_JWT_REFRESH_SECRET_PREVIOUS=

# BullMQ / Redis (job queues + workers). Optional locally; required for durable jobs.
# REDIS_URL=redis://127.0.0.1:6379

# Email (platform notifications, invitations) — queue-backed sends in worker
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@zerowix.cloud

# Storage (Backblaze B2 / S3 Compatible)
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET_NAME=zerowix-pos
# B2_BUCKET_ID=
# B2_ENDPOINT=s3.us-east-005.backblazeb2.com
# B2_REGION=us-east-005
# Public base URL for uploaded files (recommended in production).
# Examples:
# - https://cdn.yourdomain.com
# - https://f000.backblazeb2.com/file/your-bucket
# When unset, backend falls back to https://<bucket>.<B2_ENDPOINT>/<key>.
# B2_PUBLIC_BASE_URL=
# Optional alias (legacy/flexible deployments). Used only when B2_PUBLIC_BASE_URL is not set.
# UPLOADS_PUBLIC_ORIGIN=

# Optional: Sentry DSN for API + worker error tracking
# SENTRY_DSN=

# Optional: encrypt MFA secrets / PII blobs (32 bytes, base64)
# FIELD_ENCRYPTION_KEY=

# Platform owner bootstrap: npm run seed:platform-owner
# PLATFORM_OWNER_EMAIL=
# PLATFORM_OWNER_PASSWORD=

# Read-only support role (RBAC / E2E): npm run seed:platform-support-read
# PLATFORM_SUPPORT_READ_EMAIL=
# PLATFORM_SUPPORT_READ_PASSWORD=

# Single-tenant → org migration slug/name
# DEFAULT_ORG_SLUG=default-restaurant
# DEFAULT_ORG_NAME=Default Restaurant

# Support impersonation (off by default)
# PLATFORM_IMPERSONATION_ENABLED=false

# SLO stub for metrics summary
# SLO_AVAILABILITY_TARGET=0.999

# Organization create + tenant URL diagnostic (API + optional Next tenant app must be running)
# npm run test:org-tenant-url
# ORG_TENANT_SELFTEST_API_BASE=http://127.0.0.1:8010
# ORG_TENANT_SELFTEST_TENANT_APP_BASE=http://localhost:3000
# ORG_TENANT_SELFTEST_SKIP_TENANT_HTTP=1
# ORG_TENANT_SELFTEST_SKIP_PIN=1
# ORG_TENANT_SELFTEST_CLEANUP=1
# ORG_TENANT_SELFTEST_BOOTSTRAP_WAIT_MS=120000
