{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "files": ["app.js"],
  "include": [
    "config/**/*.js",
    "constants/**/*.js",
    "controllers/**/*.js",
    "middlewares/**/*.js",
    "migrations/**/*.js",
    "models/**/*.js",
    "plugins/**/*.js",
    "routes/**/*.js",
    "scripts/**/*.js",
    "services/**/*.js",
    "utils/**/*.js",
    "workers/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
