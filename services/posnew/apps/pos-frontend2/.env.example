# Copy to `.env.local` for local dev.

# Shared API origin for all tenants. Tenant org is inferred from the POS frontend host
# subdomain (e.g. mcdonalds.pos.zerowix.cloud), not from this API URL.
# In local dev, keep this pointed at your backend port.
NEXT_PUBLIC_POS_API_ORIGIN=http://localhost:8010

# Staff PIN login: http://localhost:3000/login

# Optional dev-only: paste `accessToken` from POST /api/auth/login JSON if RBAC still returns 401
# (e.g. browser blocks cross-port cookies). Prefer backend POS_DEV_CROSS_SITE_COOKIES=true + re-login.
# NEXT_PUBLIC_POS_ACCESS_TOKEN=
