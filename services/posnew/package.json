{
  "name": "restaurant-pos-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate:platform-api": "openapi-typescript apps/pos-backend/openapi/platform-v1.yaml -o packages/platform-api/src/platform-v1.d.ts",
    "build:all": "pnpm --filter studio-admin build",
    "typecheck": "tsc --noEmit -p apps/pos-frontend2/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json",
    "test:accounting:mandatory": "pnpm --filter pos-backend test:accounting:mandatory",
    "test:saas-integration": "pnpm --filter pos-backend test:saas-integration",
    "test:inventory:http-smoke": "pnpm --filter pos-backend test:inventory:http-smoke",
    "dev:all": "concurrently -n backend,frontend -c blue,green \"pnpm --filter pos-backend dev\" \"pnpm --filter studio-admin dev\"",
    "dev1": "pnpm run dev:all",
    "test:printer-phases": "bash scripts/test-printer-phases.sh",
    "test:printers": "node tools/fake-printers/run-all.js",
    "test:print:live": "pnpm --filter pos-backend test:print:live --",
    "seed:dev": "pnpm --filter pos-backend seed:dev",
    "seed:inventory-ui": "pnpm --filter pos-backend seed:inventory-ui --",
    "seed:accounting": "pnpm --filter pos-backend seed:accounting",
    "ci:architecture-guard": "node scripts/ci-architecture-guard.js",
    "test:qa-checklist": "node scripts/zerowix-qa-checklist-selftest.js"
  },
  "devDependencies": {
    "@swagger-api/apidom-core": "^1.10.2",
    "@swagger-api/apidom-ns-openapi-3-1": "^1.10.2",
    "@swagger-api/apidom-reference": "^1.10.2",
    "concurrently": "9.1.2",
    "openapi-typescript": "^7.10.1",
    "shadcn": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "zod": "^3.23.8",
    "follow-redirects": "^1.16.0",
    "hono": "4.12.14"
  },
  "packageManager": "pnpm@9.15.9"
  
}
