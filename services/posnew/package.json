{
  "name": "restaurant-pos-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate:platform-api": "openapi-typescript apps/pos-backend/openapi/platform-v1.yaml -o packages/platform-api/src/platform-v1.d.ts",
    "nx": "nx",
    "graph": "nx graph",
    "build:all": "nx run-many -t build --all",
    "typecheck": "tsc --noEmit -p apps/pos-frontend2/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json",
    "test:accounting:mandatory": "npm run test:accounting:mandatory -w pos-backend",
    "test:saas-integration": "npm run test:saas-integration -w pos-backend",
    "test:inventory:http-smoke": "npm run test:inventory:http-smoke -w pos-backend",
    "dev:all": "nx run-many -t dev -p pos-backend studio-admin --parallel=2 --output-style=stream",
    "dev1": "npm run dev:all",
    "test:printer-phases": "bash scripts/test-printer-phases.sh",
    "test:printers": "node tools/fake-printers/run-all.js",
    "test:print:live": "npm run test:print:live -w pos-backend --",
    "seed:dev": "npm run seed:dev -w pos-backend",
    "seed:inventory-ui": "npm run seed:inventory-ui -w pos-backend --",
    "seed:accounting": "npm run seed:accounting -w pos-backend",
    "ci:architecture-guard": "node scripts/ci-architecture-guard.js",
    "test:qa-checklist": "node scripts/zerowix-qa-checklist-selftest.js",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@swagger-api/apidom-core": "^1.10.2",
    "@swagger-api/apidom-ns-openapi-3-1": "^1.10.2",
    "@swagger-api/apidom-reference": "^1.10.2",
    "nx": "^21.6.4",
    "openapi-typescript": "^7.10.1",
    "patch-package": "^8.0.1",
    "shadcn": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "zod": "^3.23.8",
    "follow-redirects": "^1.16.0",
    "hono": "4.12.14"
  },
  "packageManager": "pnpm@9.0.5+sha512.a722575c18fd791f9ef71e387c6e16cc03c90d859b9b0998d0428ca0e3220828b32a96e6de73cea34edbc0f50824771b1a69c7ea36b86daa3b89c7e6d9a3d912"
}
