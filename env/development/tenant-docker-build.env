# Variables Docker Compose needs to parse infra/tenant-stack/docker-compose.yml during `docker compose build`.
# These strings are not live tenant database credentials — MySQL in compose uses secrets generated per tenant at runtime.
# CI may override via environment. Defaults ship in-repo for reproducible local builds.

BIGCAPITAL_ROOT=
STOCKIX_BC_TAG=latest
PUBLIC_PROXY_PORT=4100

DB_USER=bigcapital
DB_PASSWORD=stockix_compose_build_mysql_app_not_runtime_xx
DB_ROOT_PASSWORD=stockix_compose_build_mysql_root_not_runtime_xx
DB_CHARSET=utf8
SYSTEM_DB_NAME=bigcapital_system
TENANT_DB_NAME_PERFIX=bigcapital_tenant_
JWT_SECRET=stockix_compose_build_jwt_secret_thirtytwo_chars0
BASE_URL=https://compose-build.invalid
AGENDASH_AUTH_USER=agendash
AGENDASH_AUTH_PASSWORD=stockix_compose_build_agendash_not_runtime
SIGNUP_DISABLED=true
SIGNUP_ALLOWED_EMAILS=

MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=
MAIL_SECURE=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
