# Stockix API — local development (pnpm dev).
#
# DATABASE_URL = platform Postgres ONLY (Stockix metadata: owners, tenants, deployment rows).
# Must match packages/db/.env and root .env so migrations + API see the same DB (pnpm bootstrap:env).
#
# Tenant accounting DB is NOT here — Docker generates MySQL secrets into TENANT_ENV_ROOT/<slug>/.env at provision time.
# Do not paste tenant MySQL URLs into DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/stockix_platform

PORT=4000
ROOT_DOMAIN=localhost
PUBLIC_BASE_URL_SCHEME=http
MAX_TENANT_PORT=4999
STOCKIX_BC_TAG=latest

# Provisioning: per-request /api/ping/ timeout (ms). Cold tenant stacks may need 45s+ first response.
# PROVISION_HEALTH_FETCH_TIMEOUT_MS=45000
# PROVISION_HEALTH_TIMEOUT_MS=300000

# Uncomment and set if BigCapital is not at <repo>/services/bigcapital or tenants dir is non-default.
# BIGCAPITAL_ROOT=
# TENANT_ENV_ROOT=
