# objection-filter@4.0.1 (Finance) declares engines.node <=12; runs fine on Node 22.
engine-strict=false
fund=false
audit=true
save-exact=true
# Non-interactive installs (CI / SSH deploy) — never prompt to remove node_modules
confirm-modules-purge=false
# Single React instance for Next + react-hook-form (avoids "module factory is not available").
public-hoist-pattern[]=*react
public-hoist-pattern[]=*react-dom

# Install platform-native binaries for all dev targets so the same node_modules
# works on Windows, WSL, Linux CI, and macOS (Intel + Apple Silicon).
# Any new developer can run pnpm install once and get a working dev stack.
supportedArchitectures.os[]=win32
supportedArchitectures.os[]=linux
supportedArchitectures.os[]=darwin
supportedArchitectures.cpu[]=x64
supportedArchitectures.cpu[]=arm64
