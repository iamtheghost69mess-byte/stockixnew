# objection-filter@4.0.1 (Finance) declares engines.node <=12; runs fine on Node 22.
engine-strict=false
fund=false
audit=true
save-exact=true
# Non-interactive installs (CI / SSH deploy) — never prompt to remove node_modules
confirm-modules-purge=false
# Single React instance for Next + react-hook-form (avoids "module factory is not available").
public-hoist-pattern[]=*react
public-hoist-pattern[]=*react-dom
