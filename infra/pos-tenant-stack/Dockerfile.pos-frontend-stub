# Minimal placeholder for compose health checks only — NOT the real POS UI.
# Use: pnpm pos:images:build  (default builds apps/pos-frontend2/Dockerfile)
# Stub only: pnpm pos:images:build -- --stub-frontend
FROM busybox:1.37.0-musl
LABEL io.stockix.image=pos-frontend-stub
RUN mkdir -p /www \
    && printf 'POS frontend placeholder\n' > /www/index.html
EXPOSE 3000
CMD ["httpd", "-f", "-p", "3000", "-h", "/www"]
