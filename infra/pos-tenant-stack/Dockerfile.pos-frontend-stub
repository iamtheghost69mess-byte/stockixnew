# Minimal placeholder until Next.js tenant frontend image builds in CI.
# Serves HTTP 200 on port 3000 for compose health; replace with apps/pos-frontend2/Dockerfile build.
FROM nginx:alpine
RUN printf 'server { listen 3000; location / { return 200 "POS frontend placeholder\\n"; add_header Content-Type text/plain; } }\n' \
    > /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
