# Copy to .env and fill in values. Used by: docker compose --env-file .env
#
# Shared VPS: keep this repo under /opt/stockix/app only. If another Postgres already uses
# host port 54330, set POSTGRES_HOST_PORT to a free port (e.g. 54331) and use the same
# value in DATABASE_URL for migrations. Only one service may bind host ports 80 and 443.

# --- Core domain (public DNS should point to this host; Cloudflare proxy recommended) ---
ROOT_DOMAIN=stockix.cloud

# Browser → API (Next.js build arg; set to your public API URL)
NEXT_PUBLIC_STOCKIX_API_URL=https://api.stockix.cloud

# Extra CORS origins (comma-separated). ROOT_DOMAIN adds https automatically in the API.
# CORS_ORIGINS=

# --- Postgres (control plane) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=stockix_platform
POSTGRES_HOST_PORT=54330

# --- Let's Encrypt (DNS-01 via Cloudflare — wildcard *.domain + apex) ---
ACME_EMAIL=you@stockix.cloud
CF_DNS_API_TOKEN=

# --- Repo path on the EC2 host (contains apps/, packages/, infra/, services/bigcapital/) ---
STOCKIX_REPO=/opt/stockix/app

# --- Platform admin login (dashboard) ---
# Generate SESSION_SECRET with: openssl rand -hex 32
SESSION_SECRET=
PLATFORM_ADMIN_EMAIL=admin@stockix.cloud
PLATFORM_ADMIN_PASSWORD=
