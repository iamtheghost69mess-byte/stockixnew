# Production environment template for infra/prod/docker-compose.yml
# Copy to infra/prod/.env and replace all __MUST_OVERRIDE__ values.

NODE_ENV=production

# Public routing
ROOT_DOMAIN=example.com
DASHBOARD_URL=https://example.com
CORS_ORIGINS=https://example.com,https://www.example.com
NEXT_PUBLIC_STOCKIX_API_URL=https://api.example.com

# Control-plane database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__MUST_OVERRIDE__
POSTGRES_DB=stockix_platform
POSTGRES_HOST_PORT=54330

# API and worker secrets
PLATFORM_API_SECRET=__MUST_OVERRIDE__
WORKER_SECRET=__MUST_OVERRIDE__
SESSION_SECRET=__MUST_OVERRIDE__
AUTH_TOKEN_SECRET=__MUST_OVERRIDE__
DEPLOYMENT_SECRET_KEY=__MUST_OVERRIDE__
# POS offline license JWT signing (min 32 characters; must match across API restarts)
LICENSE_SIGNING_SECRET=__MUST_OVERRIDE__

# Dashboard bootstrap admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=__MUST_OVERRIDE__

# TLS and DNS automation
ACME_EMAIL=ops@example.com
CF_DNS_API_TOKEN=__MUST_OVERRIDE__

# Paths on host
STOCKIX_REPO=/opt/stockix/stockixnew

# Optional telemetry sink
METRICS_ENDPOINT=
METRICS_AUTH_TOKEN=
