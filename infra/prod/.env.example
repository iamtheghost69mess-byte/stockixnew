# =============================================================================
# STOCKIX PRODUCTION — infra/prod/.env
# =============================================================================
# ═══════════════════════════════════════════════════
# SECRETS ROTATED: [DATE TO BE FILLED]
# Reason: .env found in git history
# Rotated by: [NAME]
# All values below are NEW — old values invalidated
# ═══════════════════════════════════════════════════
#
# Copy:  cp infra/prod/.env.example infra/prod/.env
# Secrets: node scripts/generate-env-secrets.js  (use fresh output; never reuse dev)
# Deploy:  cd infra/prod && docker compose --env-file .env up -d --build
# On server after editing:  pnpm env:sync-prod  (syncs → repo root .env for worker fallback)
# =============================================================================

# --- Core ---
NODE_ENV=production
ROOT_DOMAIN=stockix.cloud
PUBLIC_BASE_URL_SCHEME=https

# --- Platform API ---
PORT=4000
PLATFORM_API_SECRET=__MUST_OVERRIDE__
WORKER_SECRET=__MUST_OVERRIDE__
INTERNAL_API_SECRET=__MUST_OVERRIDE__
DASHBOARD_URL=https://stockix.cloud
STOCKIX_API_URL=https://api.stockix.cloud
CORS_ORIGINS=https://stockix.cloud,https://www.stockix.cloud
CORS_ALLOWED_ORIGINS=https://dashboard.stockix.cloud,https://stockix.cloud
CORS_ORIGINS=https://stockix.cloud,https://www.stockix.cloud,https://dashboard.stockix.cloud
# ─── Sentry Error Monitoring ─────────────────────────────
# Required for production error tracking and alerting
# Create project at sentry.io → Settings → Projects → DSN
# Create ONE project called 'stockix-platform'
# API + Worker use server DSN (not public)
# Dashboard uses NEXT_PUBLIC_SENTRY_DSN (safe for browser)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=stockix-platform
RELEASE_VERSION=

DB_POOL_MAX=20
DB_IDLE_TIMEOUT_SECONDS=30

# --- Auth & crypto ---
SESSION_SECRET=__MUST_OVERRIDE__
AUTH_TOKEN_SECRET=__MUST_OVERRIDE__
# Same value required on every tenant POS stack (STXI). See infra/prod/OPERATIONS.md
LICENSE_SIGNING_SECRET=__MUST_OVERRIDE__
DEPLOYMENT_SECRET_KEY=__MUST_OVERRIDE__
JWT_SECRET=__MUST_OVERRIDE__

# --- Control-plane Redis (BullMQ license expiry). Compose service: control-plane-redis
# Omit to use inline milestone processing only.
CONTROL_PLANE_REDIS_URL=redis://control-plane-redis:6379/0
# Compose sets RUN_BULLMQ_CONSUMERS=false on `api` (2 replicas) and true on `api-bullmq` only.
# Do not enable BullMQ on scaled `api` replicas — duplicate emails/notifications.

# --- Backblaze B2 backup (S3-compatible API) ---
# Create bucket + Application Key at backblaze.com
# Endpoint: https://s3.<region>.backblazeb2.com (from bucket settings)
BACKUP_B2_BUCKET=your-bucket-name
BACKUP_B2_KEY_ID=your-b2-application-key-id
BACKUP_B2_APP_KEY=your-b2-application-key
BACKUP_B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
BACKUP_B2_PREFIX=stockix-platform-backups
BACKUP_RETENTION_DAYS=30
BACKUP_POSTGRES_CONTAINER=stockix-postgres-1
ALLOW_BOOTSTRAP_LOGIN=false

# --- Signup (tenants are provisioned; keep disabled) ---
SIGNUP_DISABLED=true
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=

# --- Dashboard admins ---
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=__MUST_OVERRIDE__
BOOTSTRAP_ADMIN_EMAIL=admin@stockix.cloud
BOOTSTRAP_ADMIN_PASSWORD=__MUST_OVERRIDE__

# --- Dashboard build-time (browser) ---
NEXT_PUBLIC_STOCKIX_API_URL=https://api.stockix.cloud
NEXT_PUBLIC_STOCKIX_PUBLIC_SCHEME=https
NEXT_PUBLIC_STOCKIX_ROOT_DOMAIN=stockix.cloud

# --- Postgres (control plane) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__MUST_OVERRIDE__
POSTGRES_DB=stockix_platform
POSTGRES_HOST_PORT=54330
DATABASE_URL=postgresql://postgres:__MUST_OVERRIDE__@postgres:5432/stockix_platform

# --- Provisioning paths (host) ---
STOCKIX_REPO=/opt/stockix/stockixnew
REPO_ROOT=/opt/stockix/stockixnew
STOCKIX_TENANT_APP_ROOT=/opt/stockix/stockixnew/services/stockix-finance
TENANT_ENV_ROOT=/opt/stockix/tenants

# --- Traefik / TLS ---
TRAEFIK_DYNAMIC_DIR=/opt/stockix/traefik-dynamic
TRAEFIK_TENANT_UPSTREAM_HOST=host.docker.internal
TENANT_INTERNAL_HOST=host.docker.internal
ACME_EMAIL=ops@example.com
CF_DNS_API_TOKEN=__MUST_OVERRIDE__

# --- Mail (Resend SMTP) — https://resend.com/docs/send-with-smtp ---
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=__MUST_OVERRIDE__
MAIL_SECURE=false
MAIL_FROM_NAME=Stockix
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# ─── Resend Email Webhook ────────────────────────────────
# Required for email delivery tracking (bounces, opens, spam reports)
# Get this from: Resend dashboard → Webhooks → your endpoint → Signing Secret
# Endpoint to register in Resend: https://{API_DOMAIN}/webhooks/resend
# Without this: webhook events are rejected (fail-closed in production)
RESEND_WEBHOOK_SECRET=

# --- Tenant stacks (Mongo + worker tuning) ---
MONGODB_DATABASE_URL=mongodb://mongo/stockix
MAX_TENANT_PORT=4999
WORKER_JOB_EXECUTION_TIMEOUT_MS=2700000
WORKER_HEARTBEAT_STALE_MS=600000
WORKER_STALE_LEASE_THRESHOLD_MS=3000000
PROVISION_POLL_MS=2000
PROVISION_MAX_MS=2700000
AGENDASH_AUTH_USER=agendash
AGENDASH_AUTH_PASSWORD=__MUST_OVERRIDE__

# --- Object storage (Backblaze B2) — optional until uploads enabled ---
S3_REGION=us-east-005
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_FORCE_PATH_STYLE=true

# --- Analytics — optional ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- Metrics — optional ---
METRICS_ENDPOINT=
METRICS_AUTH_TOKEN=

# --- POS platform proxy (control-plane API → pos-backend /api/platform/v1) ---
POS_PLATFORM_BASE_URL=http://host.docker.internal:8010
# Required (min 10 chars) when provisioning tenants with the POS module.
POS_PLATFORM_API_KEY=
# Finance URL as seen from inside the per-tenant POS Docker stack (default: host.docker.internal).
POS_FINANCE_INTERNAL_HOST=host.docker.internal
# Finance host for Stockix API + worker when calling tenant Finance on the host gateway.
STOCKIX_FINANCE_INTERNAL_HOST=host.docker.internal
# POS_FINANCE_USE_TRAEFIK_URL=1

# --- PMS service ---
PMS_PORT=3003
PMS_BASE_URL=http://host.docker.internal:3003
# PMS frontend — browser-visible PMS API URL (baked in at build)
NEXT_PUBLIC_PMS_API_URL=https://pms-api.yourdomain.com
PMS_APP_ROOT=/opt/stockix/stockixnew/services/pms
POS_APP_ROOT=/opt/stockix/stockixnew/services/posnew
# PMS optional
GEMINI_API_KEY=
PMS_ICAL_SYNC_INTERVAL_MS=600000

# --- Chatwoot (shared platform instance) ---
CHATWOOT_BASE_URL=https://chat.stockix.cloud
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_DB_PASSWORD=
CHATWOOT_FRONTEND_URL=https://chat.stockix.cloud
CHATWOOT_INSTALLATION_NAME=Stockix
CHATWOOT_BRAND_NAME=
CHATWOOT_BRAND_URL=https://${ROOT_DOMAIN}
CHATWOOT_WIDGET_BRAND_URL=
CHATWOOT_LOGO_URL=/brand-assets/logo.svg
CHATWOOT_LOGO_DARK_URL=/brand-assets/logo_dark.svg
CHATWOOT_LOGO_THUMBNAIL_URL=/brand-assets/logo_thumbnail.svg
CHATWOOT_DISPLAY_MANIFEST=false
CHATWOOT_HELPCENTER_URL=

# --- Product module provisioning (1 = honor tenant modules; 0 = always provision Finance) ---
PROVISION_MODULE_GATING=1

# --- Security headers (dashboard) ---
SECURITY_HSTS=max-age=31536000; includeSubDomains
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_CSP_BASE=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
