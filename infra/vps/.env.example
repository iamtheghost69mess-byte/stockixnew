# Platform Postgres (Stockix API / Drizzle) — copy to infra/vps/.env on the VPS.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=stockix_platform

# After `docker compose ... up -d`, set apps/api/.env DATABASE_URL to:
# postgresql://postgres:CHANGE_ME_LONG_RANDOM@127.0.0.1:5432/stockix_platform
