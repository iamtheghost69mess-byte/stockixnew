# Full local development environment variables.
# Copy this file and fill in secrets:
#   cp infra/dev/.env.full.example infra/dev/.env.full
#
# This file is consumed by:
#   docker compose -f infra/dev/docker-compose.yml \
#                  -f infra/dev/docker-compose.full.yml \
#                  --env-file infra/dev/.env.full up -d
#
# NOTE: infra/dev/.env.full is gitignored — never commit it.

# -------------------------------------------------------------------
# Email (optional — leave blank to skip email delivery in local dev)
# Get a test key from https://resend.com/api-keys
# -------------------------------------------------------------------
RESEND_API_KEY=

# -------------------------------------------------------------------
# Image overrides (optional — leave blank to build from local source)
# Useful if you want to pull a pre-built image instead of building:
#   API_IMAGE=ghcr.io/your-org/stockix/stockix-api:latest
# -------------------------------------------------------------------
API_IMAGE=
DASHBOARD_IMAGE=
