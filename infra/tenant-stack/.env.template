# Template for per-tenant generated `.env` (do not commit real tenant files).
# The Stockix provisioner writes `{TENANT_ENV_ROOT}/{slug}/.env` with concrete values.
#
# Manual test:
#   docker compose -f infra/tenant-stack/docker-compose.yml -p <project> --env-file /path/to/.env up -d
#
# `BIGCAPITAL_ROOT` is also passed in the API process environment when running `docker compose`
# (alongside this file), so it may appear duplicated — both must point at the same path.

# --- Paths (Stockix) ---
# Absolute path to vendored BigCapital (contains docker/, data/, etc.)
BIGCAPITAL_ROOT=/absolute/path/to/stockix/services/bigcapital

# --- Public URL (Traefik or other edge terminates TLS) ---
BASE_URL=https://{slug}.{ROOT_DOMAIN}

# --- MySQL (Compose service name MUST be `mysql`; DB_HOST=mysql) ---
DB_HOST=mysql
DB_USER=bigcapital
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_CHARSET=utf8
SYSTEM_DB_NAME=bigcapital_system
# Upstream BigCapital env name (typo preserved): TENANT_DB_NAME_PERFIX
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# --- Application secrets (provisioner generates strong values) ---
JWT_SECRET=
# In tenant-stack compose, the server sets Mongo via compose; this line documents the internal URL.
MONGODB_DATABASE_URL=mongodb://mongo/bigcapital

# --- Nginx gateway (HTTP only in-stack; Traefik → host:PUBLIC_PROXY_PORT) ---
PUBLIC_PROXY_PORT=
# Not published on the host in Stockix v1 when edge handles TLS; kept for BigCapital compatibility.
PUBLIC_PROXY_SSL_PORT=443

# --- Sign-up (provisioner: SIGNUP_DISABLED=true + admin email only) ---
SIGNUP_DISABLED=true
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=

# --- Mail (optional; empty for this phase) ---
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=
MAIL_SECURE=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# --- Agendash (provisioner generates a password) ---
AGENDASH_AUTH_USER=agendash
AGENDASH_AUTH_PASSWORD=
