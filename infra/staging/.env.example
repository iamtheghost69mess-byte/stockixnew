# Staging — copy to infra/staging/.env (never commit)
# Based on infra/prod/.env.example with staging hostnames.

NODE_ENV=production
ROOT_DOMAIN=stockix.cloud
PUBLIC_BASE_URL_SCHEME=https
DASHBOARD_URL=https://staging.stockix.cloud
STOCKIX_API_URL=https://staging-api.stockix.cloud
API_DOMAIN=staging-api.stockix.cloud

BACKUP_B2_PREFIX=stockix-staging-backups
RUN_BULLMQ_CONSUMERS=true

# Copy remaining secrets from infra/prod/.env or root .env after local validation.
