# SENTRY
# ------------------------------------------------------------
SENTRY_DSN=https://ad96965bb2857f76be247b0f72d0ce7f@o4511463798276096.ingest.de.sentry.io/4511463841595472
NEXT_PUBLIC_SENTRY_DSN=https://ad96965bb2857f76be247b0f72d0ce7f@o4511463798276096.ingest.de.sentry.io/4511463841595472
