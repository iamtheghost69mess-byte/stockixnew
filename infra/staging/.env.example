# ============================================================
# STAGING ENVIRONMENT — infra/staging/.env.example
# Server: 76.13.51.138
# Domain: dev.stockix.cloud
#
# Copy to infra/staging/.env and fill every <GENERATE_NEW> value.
# NEVER commit infra/staging/.env — it is gitignored.
#
# Generate a secret:  openssl rand -hex 32
# First deploy:       sudo bash infra/deploy/swarm-init-staging.sh
# Subsequent deploys: bash infra/deploy/deploy.sh staging <sha>
# ============================================================

# ------------------------------------------------------------
# NODE
# ------------------------------------------------------------
NODE_ENV=staging

# ------------------------------------------------------------
# DOMAIN
# ------------------------------------------------------------
ROOT_DOMAIN=dev.stockix.cloud
PUBLIC_BASE_URL_SCHEME=https
API_DOMAIN=api.dev.stockix.cloud
STOCKIX_API_URL=https://api.dev.stockix.cloud
DASHBOARD_URL=https://app.dev.stockix.cloud
CORS_ORIGINS=https://app.dev.stockix.cloud,https://www.dev.stockix.cloud
CORS_ALLOWED_ORIGINS=https://app.dev.stockix.cloud,https://www.dev.stockix.cloud

# ------------------------------------------------------------
# DASHBOARD PUBLIC
# ------------------------------------------------------------
NEXT_PUBLIC_STOCKIX_API_URL=https://api.dev.stockix.cloud
NEXT_PUBLIC_STOCKIX_PUBLIC_SCHEME=https
NEXT_PUBLIC_STOCKIX_ROOT_DOMAIN=dev.stockix.cloud
NEXT_PUBLIC_PMS_API_URL=https://pms.dev.stockix.cloud

# ------------------------------------------------------------
# SHARED TENANT INFRA (stockix-staging-shared network)
# ------------------------------------------------------------
SHARED_MYSQL_ROOT_PASSWORD=<GENERATE_NEW>
SHARED_MYSQL_HOST=stockix-mysql
SHARED_MONGO_HOST=stockix-mongo
MYSQL_PROXY_HOST=stockix-mysql-proxy
MYSQL_PROXY_PORT=6033
WORKER_MYSQL_PROXY_PORT=6033
TENANT_REDIS_HOST=stockix-redis
TENANT_REDIS_PASSWORD=<GENERATE_NEW>

# ------------------------------------------------------------
# PLATFORM SECRETS  (generate fresh — never reuse prod values)
# ------------------------------------------------------------
PLATFORM_API_SECRET=<GENERATE_NEW>
WORKER_SECRET=<GENERATE_NEW>
INTERNAL_API_SECRET=<GENERATE_NEW>
SESSION_SECRET=<GENERATE_NEW>
AUTH_TOKEN_SECRET=<GENERATE_NEW>
LICENSE_SIGNING_SECRET=<GENERATE_NEW>
DEPLOYMENT_SECRET_KEY=<GENERATE_NEW>
JWT_SECRET=<GENERATE_NEW>
PLATFORM_JWT_SECRET=<GENERATE_NEW>

# ------------------------------------------------------------
# ADMIN ACCOUNTS
# ------------------------------------------------------------
PLATFORM_ADMIN_EMAIL=jad.haidar.ahmad315@gmail.com
PLATFORM_ADMIN_PASSWORD=<GENERATE_NEW>
BOOTSTRAP_ADMIN_EMAIL=admin@dev.stockix.cloud
BOOTSTRAP_ADMIN_PASSWORD=<GENERATE_NEW>
ALLOW_BOOTSTRAP_LOGIN=false

# ------------------------------------------------------------
# SIGNUP POLICY  (open in staging for test tenant creation)
# ------------------------------------------------------------
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=

# ------------------------------------------------------------
# SSL / ACME
# The stockix.cloud CF token covers dev.stockix.cloud (same zone).
# You can reuse the same CF_DNS_API_TOKEN as production.
# ------------------------------------------------------------
ACME_EMAIL=jad.haidar.ahmad315@gmail.com
CF_DNS_API_TOKEN=<SAME_AS_PROD_OR_NEW_TOKEN>

# ------------------------------------------------------------
# DATABASE (Postgres control plane)
# Port 54331 avoids conflict if prod Postgres is also on this host.
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<GENERATE_NEW>
POSTGRES_DB=stockix_platform
POSTGRES_HOST_PORT=54331
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@pgbouncer:5432/stockix_platform

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_MAX_LIFETIME_SECONDS=1800

# ------------------------------------------------------------
# REDIS — control plane
# ------------------------------------------------------------
CONTROL_PLANE_REDIS_URL=redis://control-plane-redis:6379/0
RUN_BULLMQ_CONSUMERS=true

# ------------------------------------------------------------
# PROVISIONING PATHS  (staging server paths)
# ------------------------------------------------------------
STOCKIX_TENANT_APP_ROOT=/opt/stockix/stockixnew/services/stockix-finance
TENANT_ENV_ROOT=/opt/stockix/tenants
REPO_ROOT=/opt/stockix/stockixnew
STOCKIX_REPO=/opt/stockix/stockixnew

# ------------------------------------------------------------
# TRAEFIK
# ------------------------------------------------------------
TRAEFIK_DYNAMIC_DIR=/opt/stockix/traefik-dynamic
TRAEFIK_TENANT_UPSTREAM_HOST=host.docker.internal
TENANT_INTERNAL_HOST=host.docker.internal
TRAEFIK_LABELS_ENABLED=false
WORKER_INTERNAL_NETWORK=stockix_internal
TRAEFIK_NETWORK=stockix_public
MAX_TENANT_PORT=4999
# htpasswd -nb admin <password>
TRAEFIK_DASHBOARD_BASIC_AUTH=admin:$$2y$$05$$<GENERATE_HTPASSWD>

# ------------------------------------------------------------
# WORKER / JOBS
# ------------------------------------------------------------
WORKER_HEALTH_PORT=9090
WORKER_CONCURRENCY=2
WORKER_JOB_EXECUTION_TIMEOUT_MS=600000
WORKER_STARTUP_GRACE_MS=5000
WORKER_HEARTBEAT_STALE_MS=600000
WORKER_STALE_LEASE_THRESHOLD_MS=3000000
PROVISION_POLL_MS=2000
PROVISION_MAX_MS=2700000
DOCKER_COMPOSE_UP_TIMEOUT_MS=1800000
DOCKER_COMPOSE_RUN_TIMEOUT_MS=900000
DOCKER_COMPOSE_DEFAULT_TIMEOUT_MS=600000
AGENDASH_AUTH_USER=agendash
AGENDASH_AUTH_PASSWORD=<GENERATE_NEW>
PORT=4000

# ------------------------------------------------------------
# MAIL (Resend SMTP — reuse prod account, separate FROM address)
# ------------------------------------------------------------
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_gPYUgdFf_3Xtibw8rBfSHbHGACHwSS2aT
MAIL_SECURE=false
MAIL_FROM_NAME=Stockix Staging
MAIL_FROM_ADDRESS=noreply@send.stockix.cloud
RESEND_API_KEY=re_gPYUgdFf_3Xtibw8rBfSHbHGACHwSS2aT
RESEND_FROM_EMAIL=noreply@send.stockix.cloud
RESEND_WEBHOOK_SECRET=whsec_W2nWgBeeEX//xN3B72QdRx5mEC4WVyMy

