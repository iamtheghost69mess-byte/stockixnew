admin_variables=
{
    admin_credentials="admin:admin"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    threads=4
    max_connections=2048
    default_query_delay=0
    default_query_timeout=36000000
    have_compress=true
    poll_timeout=2000
    interfaces="0.0.0.0:6033"
    default_schema="information_schema"
    stacksize=1048576
    server_version="8.0.0"
    connect_timeout_server=10000
    monitor_username="root"
    monitor_password="__MYSQL_ROOT_PASSWORD__"
}

mysql_servers =
(
    {
        address="stockix-mysql"
        port=3306
        hostgroup=0
        max_connections=200
        comment="shared-mysql"
    }
)

mysql_users =
(
    {
        username = "root"
        password = "__MYSQL_ROOT_PASSWORD__"
        default_hostgroup = 0
        active = 1
        max_connections = 100
    }
)

mysql_query_rules =
(
    {
        rule_id=1
        active=1
        match_pattern=".*"
        destination_hostgroup=0
        apply=1
    }
)
