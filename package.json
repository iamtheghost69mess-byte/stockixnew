{
  "name": "stockix",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=dashboard --filter=api",
    "dev:apps": "turbo run dev --filter=dashboard --filter=api",
    "db:up": "docker compose -f infra/dev/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/dev/docker-compose.yml down",
    "db:wait": "pnpm --filter @repo/db db:wait",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed:local": "pnpm --filter @repo/db db:seed:local",
    "bootstrap:env": "node scripts/bootstrap-local-env.mjs",
    "bootstrap:env:force": "node scripts/bootstrap-local-env.mjs --force",
    "setup:local": "pnpm bootstrap:env && pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm db:seed:local",
    "provision:prepull": "node scripts/prepull-tenant-stack-images.mjs",
    "repair:tenant-mysql": "node scripts/repair-tenant-mysql-auth.mjs",
    "repair:tenant": "node scripts/repair-tenant-stack.mjs",
    "images:pull": "node scripts/stockix-docker-pull.mjs",
    "images:tenant": "node scripts/build-stockix-tenant-images.mjs",
    "images:tenant:minimal": "node scripts/build-stockix-tenant-images.mjs --minimal",
    "images:fresh": "node scripts/docker-fresh-images.mjs",
    "db:reset:local": "docker compose -f infra/dev/docker-compose.yml down -v && pnpm setup:local",
    "provision:preflight": "node scripts/provision-preflight.mjs",
    "verify:provision-ready": "node scripts/verify-provision-ready.mjs",
    "stockix:reset-local": "node scripts/stockix-local-reset.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.9"
}
