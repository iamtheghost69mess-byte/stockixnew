{
  "name": "stockix",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=dashboard --filter=api",
    "dev:apps": "turbo run dev --filter=dashboard --filter=api",
    "db:up": "docker compose -f infra/dev/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/dev/docker-compose.yml down",
    "db:wait": "pnpm --filter @repo/db db:wait",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed:local": "pnpm --filter @repo/db db:seed:local",
    "infra:worker:build": "pnpm --filter api exec tsup --config tsup.worker.config.ts",
    "infra:worker:run": "node infra/worker-service/.runtime/worker.js",
    "infra:worker:dev": "pnpm infra:worker:build && pnpm infra:worker:run",
    "bootstrap:env": "node scripts/bootstrap-local-env.mjs",
    "bootstrap:env:force": "node scripts/bootstrap-local-env.mjs --force",
    "setup:local": "pnpm bootstrap:env && pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm db:seed:local",
    "db:reset:local": "docker compose -f infra/dev/docker-compose.yml down -v && pnpm setup:local",
    "lint": "turbo run lint",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "architecture:validate": "node scripts/architecture-validation.mjs",
    "test:phase2": "pnpm --filter api test && pnpm --filter dashboard test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "tsx": "4.20.6",
    "turbo": "^2.9.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "execa": "^9.5.2",
    "zod": "^3.24.1"
  }
}
