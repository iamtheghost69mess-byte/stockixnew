{
  "name": "stockix",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev-stockix.mjs",
    "dev:all": "pnpm dev",
    "dev:apps": "turbo run dev --filter=dashboard --filter=api",
    "dev:pms": "node scripts/dev-pms.mjs",
    "dev:pms:ui": "node scripts/dev-pms-frontend.mjs",
    "dev:pms:stack": "concurrently -n api,pms,pms-ui -c blue,cyan,yellow \"node scripts/dev-api.mjs\" \"node scripts/dev-pms.mjs\" \"node scripts/dev-pms-frontend.mjs\"",
    "dev:pos": "node scripts/dev-pos-stack.mjs",
    "dev:pos:backend": "pnpm --filter pos-backend dev",
    "dev:pos:frontend": "pnpm --filter studio-admin dev",
    "build:pos": "pnpm --filter studio-admin build",
    "test:pos": "pnpm --filter pos-backend test",
    "worker:bigcapital": "pnpm --filter pos-backend worker:bigcapital",
    "db:up": "docker compose -f infra/dev/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/dev/docker-compose.yml down",
    "db:wait": "pnpm --filter @repo/db db:wait",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed:local": "pnpm --filter @repo/db db:seed:local",
    "db:seed:pms-demo": "pnpm --filter @repo/db db:seed:pms-demo",
    "sync:platform-admin": "pnpm --filter api exec tsx src/scripts/sync-platform-admin.ts",
    "infra:worker:build": "pnpm --filter api exec tsup --config tsup.worker.config.ts",
    "infra:worker:run": "node infra/worker-service/.runtime/worker.js",
    "infra:worker:dev": "pnpm infra:worker:build && pnpm infra:worker:run",
    "get-password": "node scripts/get-bootstrap-password.mjs",
    "bootstrap:env": "node scripts/bootstrap-local-env.mjs",
    "env:sync-prod": "node scripts/sync-prod-env-to-root.mjs --confirm-server",
    "env:audit": "node scripts/audit-env.mjs",
    "env:sync-pos": "node scripts/sync-pos-env-from-root.mjs",
    "env:align-local": "node scripts/align-root-env-gaps.mjs && node scripts/sync-pos-env-from-root.mjs",
    "env:fill-prod-gaps": "node scripts/fill-prod-env-gaps.mjs",
    "bootstrap:env:force": "node scripts/bootstrap-local-env.mjs --force",
    "debug:db": "node scripts/debug-db.mjs",
    "setup:local": "pnpm bootstrap:env && pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm db:seed:local && pnpm db:seed:pms-demo",
    "db:reset:local": "docker compose -f infra/dev/docker-compose.yml down -v && pnpm setup:local",
    "cleanup:tenant-local": "node scripts/cleanup-tenant-docker-local.mjs",
    "docker:prebuild": "node scripts/prebuild-tenant-images.mjs",
    "pos:images:build": "node scripts/build-pos-tenant-images.mjs",
    "docker:prebuild:force": "node scripts/prebuild-tenant-images.mjs --force",
    "docker:check": "node scripts/prebuild-tenant-images.mjs --verify",
    "provision:diagnose": "pnpm --filter api exec node scripts/provision-diagnose.mjs --",
    "provision:smoke": "pnpm --filter api exec node scripts/provision-smoke.mjs --full",
    "provision:test": "node scripts/provision-test-local.mjs",
    "provision:modules": "pnpm --filter api exec node scripts/provision-module-matrix.mjs --",
    "lint": "turbo run lint",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "architecture:validate": "node scripts/architecture-validation.mjs",
    "test:phase2": "pnpm --filter api test && pnpm --filter dashboard test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "license:scan": "license-checker --production --excludeLicenses \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Python-2.0;Unlicense\" --out license-report.txt"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "license-checker": "^25.0.1",
    "prettier": "^3.7.4",
    "tsx": "4.20.6",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "zod": "^3.24.1",
      "tough-cookie@<4.1.3": ">=4.1.3",
      "esbuild@<=0.24.2": ">=0.25.0",
      "form-data@<2.5.4": ">=2.5.4",
      "nodemailer@<7.0.7": ">=7.0.7",
      "nodemailer@<=7.0.10": ">=7.0.11",
      "qs@<6.14.1": ">=6.14.1",
      "nodemailer@<8.0.4": ">=8.0.4",
      "nodemailer@<=8.0.4": ">=8.0.5",
      "postcss@<8.5.10": ">=8.5.10",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "hono@<4.12.18": ">=4.12.18",
      "next@>=16.0.0 <16.2.5": ">=16.2.5",
      "ip-address@<=10.1.0": ">=10.1.1",
      "next@>=16.0.0 <16.2.6": ">=16.2.6",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "uuid@<11.1.1": ">=11.1.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2"
    }
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "bullmq": "^5.40.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "execa": "^9.5.2",
    "ioredis": "^5.4.2",
    "knex": "^3.1.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^6.9.13",
    "postgres": "^3.4.7",
    "zod": "^3.24.1"
  }
}
