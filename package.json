{
  "name": "stockix",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm infra:worker:build && concurrently -n apps,worker -c blue,magenta \"pnpm exec turbo run dev --filter=dashboard --filter=api\" \"node infra/worker-service/.runtime/worker.js\"",
    "dev:all": "pnpm dev",
    "dev:apps": "turbo run dev --filter=dashboard --filter=api",
    "db:up": "docker compose -f infra/dev/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/dev/docker-compose.yml down",
    "db:wait": "pnpm --filter @repo/db db:wait",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed:local": "pnpm --filter @repo/db db:seed:local",
    "sync:platform-admin": "pnpm --filter api exec tsx src/scripts/sync-platform-admin.ts",
    "infra:worker:build": "pnpm --filter api exec tsup --config tsup.worker.config.ts",
    "infra:worker:run": "node infra/worker-service/.runtime/worker.js",
    "infra:worker:dev": "pnpm infra:worker:build && pnpm infra:worker:run",
    "get-password": "node scripts/get-bootstrap-password.mjs",
    "bootstrap:env": "node scripts/bootstrap-local-env.mjs",
    "env:sync-prod": "node scripts/sync-prod-env-to-root.mjs --confirm-server",
    "bootstrap:env:force": "node scripts/bootstrap-local-env.mjs --force",
    "debug:db": "node scripts/debug-db.mjs",
    "setup:local": "pnpm bootstrap:env && pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm db:seed:local",
    "db:reset:local": "docker compose -f infra/dev/docker-compose.yml down -v && pnpm setup:local",
    "cleanup:tenant-local": "node scripts/cleanup-tenant-docker-local.mjs",
    "provision:diagnose": "pnpm --filter api exec node scripts/provision-diagnose.mjs --",
    "provision:smoke": "pnpm --filter api exec node scripts/provision-smoke.mjs --full",
    "provision:test": "node scripts/provision-test-local.mjs",
    "lint": "turbo run lint",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "architecture:validate": "node scripts/architecture-validation.mjs",
    "test:phase2": "pnpm --filter api test && pnpm --filter dashboard test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "prettier": "^3.7.4",
    "tsx": "4.20.6",
    "turbo": "^2.9.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "execa": "^9.5.2",
    "knex": "^3.1.0",
    "mysql2": "^3.11.3",
    "postgres": "^3.4.7",
    "zod": "^3.24.1"
  }
}
