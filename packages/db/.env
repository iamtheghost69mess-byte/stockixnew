# Stockix control-plane Postgres (matches infra/dev/docker-compose.yml: user postgres, port 54330).
# Run from repo root: pnpm db:up && pnpm db:wait && pnpm db:migrate
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/stockix_platform

# Optional: how long packages/db/scripts/wait-local-postgres.mjs waits (ms).
# DB_WAIT_TIMEOUT_MS=90000
